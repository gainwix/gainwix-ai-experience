{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__cloud-run__deploy.*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate-production.js"]
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate-production.js"]
          }
        ]
      }
    ]
  }
}
